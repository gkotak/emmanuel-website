  <script>
    (function(){
      var btn = document.getElementById('em-hamburger');
      var nav = document.getElementById('em-nav');
      if (!btn || !nav) return;

      // Hamburger open/close
      btn.addEventListener('click', function(){
        var open = nav.classList.toggle('is-open');
        btn.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', open);
      });

      // Sub-menu tap toggle on mobile
      nav.querySelectorAll('.em-nav-link.has-sub').forEach(function(link) {
        link.addEventListener('click', function(e) {
          // Only intercept on mobile (hamburger visible)
          if (window.getComputedStyle(btn).display === 'none') return;
          e.preventDefault();
          var item = link.closest('.em-nav-item');
          var wasOpen = item.classList.contains('is-open');
          // Close all others
          nav.querySelectorAll('.em-nav-item.is-open').forEach(function(el) {
            el.classList.remove('is-open');
          });
          // Toggle this one
          item.classList.toggle('is-open', !wasOpen);
        });
      });

      // Close nav on outside click
      document.addEventListener('click', function(e){
        if (!nav.contains(e.target) && !btn.contains(e.target)) {
          nav.classList.remove('is-open');
          btn.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          nav.querySelectorAll('.em-nav-item.is-open').forEach(function(el) {
            el.classList.remove('is-open');
          });
        }
      });
    })();
  </script>
