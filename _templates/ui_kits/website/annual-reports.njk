      <div>
        <h3 data-editable="text" data-prop="callout_heading" data-type="span">{{ callout_heading }}</h3>
        <p data-editable="text" data-prop="callout_body" data-type="text">{{ callout_body }}</p>
      </div>
      <div style="display:flex;gap:14px;flex-wrap:wrap"><a href="electoral-roll.html" class="em-btn em-btn--tan">Join the electoral roll</a><a href="contact.html" class="em-btn em-btn--ghost-light">Contact the parish office</a></div>
