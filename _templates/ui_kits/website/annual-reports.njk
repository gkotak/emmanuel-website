              <div class="t" data-editable="text" data-prop="report_title" data-type="span">{{ report_title }}</div>
              <div class="d" data-editable="text" data-prop="report_desc" data-type="span">{{ report_desc }}</div>
            </div>
            <div class="arr">Open ↗</div>
          </a>
          <a href="{{ statements_url }}" target="_blank" rel="noopener" class="em-doc">
