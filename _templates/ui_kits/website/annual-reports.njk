</head>
<body>

{% include "header.njk" %}

  <section class="em-pagehead em-pagehead--band em-pagehead--plain">
    <div class="inner">
      <div class="em-breadcrumb"><a href="index.html">Home</a><span class="sep">/</span><a href="our-team.html">About Us</a><span class="sep">/</span><span>Annual Reports</span></div>
      <h1 data-editable="text" data-prop="headline" data-type="span">{{ headline }}</h1>
      <p class="deck" data-editable="text" data-prop="deck" data-type="text">{{ deck }}</p>
    </div>
  </section>
  <section class="em-intro em-intro--solo">
    <div class="inner">
      <div class="em-body">
        <p class="em-lead" data-editable="text" data-prop="lead" data-type="text">{{ lead }}</p>
        <div style="margin-top:40px">
