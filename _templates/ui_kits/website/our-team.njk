---
permalink: /ui_kits/website/our-team.html
title: Our Team
clergy_label: Clergy
staff_label: Staff and Volunteers
callout:
  - heading: Come and say hello!
    body: The best way to meet the team is in person — do introduce yourself
      after a Sunday service, or get in touch with the parish office any time.
    primary_button:
      - label: Planning your first visit
        href: /ui_kits/website/im-new.html
    secondary_button:
      - label: Contact us
        href: /ui_kits/website/contact.html
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<title>{{ title }} — Emmanuel Church, West Hampstead</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="stylesheet" href="/styles.css" />
<style>

  body {
    margin: 0;
    background: var(--paper);
    font-family: var(--font-sans);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  @media (max-width: 768px) {
    /* Clergy rows: stack portrait above bio */
    .em-clergy-rows { gap: 32px; }
    .em-clergy-rows .em-member { grid-template-columns: 1fr !important; gap: 20px !important; }
    .em-clergy-rows .em-member .em-portrait { aspect-ratio: 4/3; height: auto; }

    /* Staff team grid: 2 columns */
    .em-team-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 28px; }

    /* Portrait height — keep portraits square but not too tall */
    .em-portrait { aspect-ratio: 1/1; height: auto !important; max-height: 180px; }

    /* Bio text size */
    .em-member p { font-size: 14px; }
    .em-member h3 { font-size: 20px; }
    .em-member .role { font-size: 10px; }

    /* Section spacing */
    .em-section { padding-top: 48px; padding-bottom: 48px; }
  }
  @media (max-width: 480px) {
    .em-team-grid { grid-template-columns: 1fr !important; }
  }

  .em-member h3 { display: inline-flex; align-items: center; gap: 8px; }
  .em-member-email { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: var(--radius-sm); color: var(--brown); flex: none; transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease); }
  .em-member-email svg { width: 26px; height: 26px; }
  .em-member-email:hover { background: var(--brown); color: #fff; }
  .em-member-email:focus-visible { outline: 2px solid var(--brown); outline-offset: 2px; }
</style>
<link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
</head>
<body>

{% include "header.njk" %}

  <section class="em-pagehead em-pagehead--band em-pagehead--plain">
    <div class="inner">
      <div class="em-breadcrumb"><a href="/ui_kits/website/index.html">Home</a><span class="sep">/</span><a href="#">About Us</a><span class="sep">/</span><span>{{ title }}</span></div>
      <h1 data-editable="text" data-prop="title" data-type="span">{{ title }}</h1>
    </div>
  </section>

  {# Clergy section — people come from Who's Who collection (Data editor), not this page #}
  <section class="em-section">
    <div class="inner">
      <div class="em-ornament em-ornament--section is-leading" data-editable="text" data-prop="clergy_label" data-type="span">{{ clergy_label }}</div>
      <div class="em-clergy-rows">
        {% for person in people %}
          {% if person.group === "clergy" %}
          <div class="em-member">
            {% if person.photoUrl %}
            <div class="em-portrait"><img src="{{ person.photoUrl }}" alt="{{ person.name }}" /></div>
            {% else %}
            <div class="em-portrait"><div class="em-img-placeholder"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg></div></div>
            {% endif %}
            <div>
              <div class="role">{{ person.role }}</div>
              <h3>{{ person.name }}{% if person.email %}<a class="em-member-email" href="mailto:{{ person.email }}" aria-label="Email {{ person.name }}" title="Email {{ person.name }}"><svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg></a>{% endif %}</h3>
              {% if person.bio %}
                {% for para in person.bio %}
                  <p>{{ para }}</p>
                {% endfor %}
              {% endif %}
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {# Staff & volunteers section #}
  <section class="em-section em-section--band">
    <div class="inner">
      <div class="em-ornament em-ornament--section is-leading" data-editable="text" data-prop="staff_label" data-type="span">{{ staff_label }}</div>
      <div class="em-team-grid">
        {% for person in people %}
          {% if person.group === "staff" %}
          <div class="em-member">
            {% if person.photoUrl %}
            <div class="em-portrait"><img src="{{ person.photoUrl }}" alt="{{ person.name }}" /></div>
            {% else %}
            <div class="em-portrait"><div class="em-img-placeholder"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg></div></div>
            {% endif %}
            <div class="role">{{ person.role }}</div>
            <h3>{{ person.name }}{% if person.email %}<a class="em-member-email" href="mailto:{{ person.email }}" aria-label="Email {{ person.name }}" title="Email {{ person.name }}"><svg viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg></a>{% endif %}</h3>
            {% if person.bio %}
              {% for para in person.bio %}
                <p class="pending">{{ para }}</p>
              {% endfor %}
            {% endif %}
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  {% for c in callout %}
  <section class="em-callout">
    <div class="inner">
      <div>
        <h3 data-editable="text" data-prop="heading" data-type="span">{{ c.heading }}</h3>
        <p data-editable="text" data-prop="body" data-type="text">{{ c.body }}</p>
      </div>
      {% if (c.primary_button and c.primary_button.length) or (c.secondary_button and c.secondary_button.length) %}
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        {% for btn in c.primary_button %}<a href="{{ btn.href }}"{% if btn.href | isExternal %} target="_blank" rel="noopener"{% endif %} class="em-btn em-btn--tan">{{ btn.label }}</a>{% endfor %}
        {% for btn in c.secondary_button %}<a href="{{ btn.href }}"{% if btn.href | isExternal %} target="_blank" rel="noopener"{% endif %} class="em-btn em-btn--ghost-light">{{ btn.label }}</a>{% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endfor %}

{% include "footer.njk" %}

</body>
</html>
