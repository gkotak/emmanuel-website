---
permalink: /ui_kits/website/privacy-policy.html
title: GDPR Privacy Notice
subtitle: Our Privacy Notices and forms relating to the data protection legislation governing our life at
  Emmanuel.
intro_content: >-
  The rules for Data Protection came into force on Friday 25 May 2018.


  Please find below our Privacy Notices and forms relating to this legislation governing our life at Emmanuel. If you have any questions about how we hold or use your data, please contact the Parish Office.
callout:
  - heading: Questions about your data?
    body: If you'd like to know how we hold or use your information, the Parish Office will be glad
      to help.
    primary_button:
      - label: Contact the parish office
        href: contact.html
    secondary_button:
      - label: Safeguarding
        href: safeguarding.html
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<title>GDPR Privacy Notice — Emmanuel Church, West Hampstead</title>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="stylesheet" href="/styles.css" />
<link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
</head>
<body>

{% include "header.njk" %}

  <section class="em-pagehead em-pagehead--band em-pagehead--plain">
    <div class="inner">
      <div class="em-breadcrumb"><a href="index.html">Home</a><span class="sep">/</span><span>GDPR Privacy Notice</span></div>
      <h1>{{ title }}</h1>
      <p class="deck">{{ subtitle }}</p>
    </div>
  </section>

  <section class="em-intro em-intro--solo">
    <div class="inner">
      <div class="em-body">
        <div data-editable="text" data-prop="intro_content" data-type="html">
          {% for para in intro_content.split("\n\n") %}<p>{{ para | trim | safe }}</p>{% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section class="em-section em-section--band" style="padding-top:0; background:var(--bg); border:none;">
    <div class="inner inner--narrow">
      <div class="em-sectionhead" style="margin-bottom:36px">
        <div class="em-ornament is-leading">Documents</div>
        <h2 style="font-size:36px">Privacy notices &amp; consent forms</h2>
      </div>

      <a class="em-doc" href="/assets/cms/privacy-policy/Emmanuel-Church-Privacy-Policy-for-non-role-holders.pdf" target="_blank" rel="noopener">
        <span class="ic"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
        <div class="doc-main">
          <div class="t">Emmanuel Church Privacy Policy for non-role holders</div>
          <div class="d">PDF · For members of the congregation and the wider community</div>
        </div>
        <span class="arr">Download →</span>
      </a>

      <a class="em-doc" href="/assets/cms/privacy-policy/Emmanuel-Church-Privacy-Policy-for-role-holders.pdf" target="_blank" rel="noopener">
        <span class="ic"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
        <div class="doc-main">
          <div class="t">Emmanuel Church Privacy Policy for role holders</div>
          <div class="d">PDF · For clergy, officers, PCC members and volunteers</div>
        </div>
        <span class="arr">Download →</span>
      </a>

      <a class="em-doc" href="/assets/cms/privacy-policy/Emmanuel-GDPR-consent-form-word-version.docx" target="_blank" rel="noopener">
        <span class="ic"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h4"/></svg></span>
        <div class="doc-main">
          <div class="t">Emmanuel GDPR consent form</div>
          <div class="d">Word version (.docx) · Editable consent form</div>
        </div>
        <span class="arr">Download →</span>
      </a>

      <a class="em-doc" href="/assets/cms/privacy-policy/Emmanuel-GDPR-consent-form-pdf.pdf" target="_blank" rel="noopener">
        <span class="ic"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
        <div class="doc-main">
          <div class="t">Emmanuel GDPR consent form</div>
          <div class="d">PDF · Print-and-sign consent form</div>
        </div>
        <span class="arr">Download →</span>
      </a>
    </div>
  </section>

  {% for c in callout %}
  <section class="em-callout">
    <div class="inner">
      <div><h3 data-editable="text" data-prop="heading" data-type="span">{{ c.heading }}</h3><p data-editable="text" data-prop="body" data-type="text">{{ c.body }}</p></div>
      {% if (c.primary_button and c.primary_button.length) or (c.secondary_button and c.secondary_button.length) %}
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        {% for btn in c.primary_button %}<a href="{{ btn.href }}"{% if btn.href | isExternal %} target="_blank" rel="noopener"{% endif %} class="em-btn em-btn--tan">{{ btn.label }}</a>{% endfor %}
        {% for btn in c.secondary_button %}<a href="{{ btn.href }}"{% if btn.href | isExternal %} target="_blank" rel="noopener"{% endif %} class="em-btn em-btn--ghost-light">{{ btn.label }}</a>{% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endfor %}

{% include "footer.njk" %}

</body>
</html>
